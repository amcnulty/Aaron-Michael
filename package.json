{
  "name": "Aaron-Michael",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "build:pug": "pug views/index.pug --out docs --obj lib/pug-cli-context.js",
    "build:copy": "ncp public/images docs/images && ncp public/javascripts docs/javascripts && ncp public/stylesheets docs/stylesheets && ncp public/vendor docs/vendor",
    "build": "npm run build:pug && npm run build:copy",
    "postinstall": "npm rebuild node-sass"
  },
  "dependencies": {
    "body-parser": "~1.18.2",
    "cookie-parser": "~1.4.3",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^4.0.0",
    "express": "~4.18.2",
    "morgan": "~1.9.1",
    "multer": "^1.4.2",
    "node-sass-middleware": "1.0.1",
    "nodemailer": "^4.4.1",
    "pug": "2.0.0-beta11",
    "serve-favicon": "~2.4.5"
  },
  "devDependencies": {
    "ncp": "^2.0.0",
    "pug-cli": "1.0.0-alpha6"
  },
  "engines": {
    "node": "16.17.1"
  }
}
